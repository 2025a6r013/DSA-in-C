#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    for(int i=0;i<n;i++){
        int found=0;
        for(int j=1;j<n;j++){
            int k=(i+j)%n;
            if(arr[k]>arr[i]){
                printf("%d ",arr[k]);
                found=1;
                break;
            }
        }
        if(found==0){
            printf("-1 ");
        }
    }
    return 0;
}
