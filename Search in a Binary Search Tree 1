#include <stdio.h>
int main() {
    int n,found=0;
    scanf("%d",&n);
    int arr[100];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int k;
    scanf("%d",&k);
    for(int i=0;i<n;i++){
        if(arr[i]==k){
            found=1;
            break;
        }
    }
    if(found){
        printf("%d found in BST",k);
    }
    else{
        printf("%d not found in BST",k);
    }
    return 0;
}
