#include <math.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <assert.h>
#include <limits.h>
#include <stdbool.h>

int main() {
    int n;
    scanf("%d",&n);
    int ticket[n];
    for(int i=0;i<n;i++){
        scanf("%d",&ticket[i]);
    }
    int p;
    scanf("%d",&p);
    int time=0;
    while(1){
        for(int i=0;i<n;i++){
            if(ticket[i]>0){
                ticket[i]--;
                time++;
                if(i==p&&ticket[i]==0){
                    printf("%d\n",time);
                    return 0;
                }
            }
        }
    }
    return 0;
}
