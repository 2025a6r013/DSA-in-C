#include <math.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <assert.h>
#include <limits.h>
#include <stdbool.h>

int main() {
    int n;
    scanf("%d",&n);
    int arr[100];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int flag=1;
    for(int i=0;i<n/2;i++){
        if(arr[i]!=arr[n-1-i]){
            flag=0;
            return 0;
        }
    }
    if(flag){
        printf("Palindrome : ");
    }
    else{
        printf("Not Palindrome : ");
    }
    for(int i=n-1;i>=0;i--){
        printf("%d ",arr[i]);
    }
    return 0;
}
