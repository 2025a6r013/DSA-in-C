#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n;
    scanf("%d",&n);
    int stu[n],sand[n];
    int count0=0,count1=0;
    for(int i=0;i<n;i++){
        scanf("%d",&stu[i]);
        if(stu[i]==0){
            count0++;
        }
        else{
            count1++;
        }
    }
    for(int i=0;i<n;i++){
        scanf("%d",&sand[i]);
    }
    for(int i=0;i<n;i++){
        if(sand[i]==0){
            if(count0==0){
                printf("%d\n",count1);
                return 0;
            }
            count0--;
        }
        else{
            if(count1==0){
                printf("%d\n",count0);
                return 0;
            }
            count1--;
        }
    }
    printf("0\n");
    return 0;
}
