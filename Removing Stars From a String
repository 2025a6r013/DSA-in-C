#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    char s[100];
    char stack[100];
    int top=-1;
    scanf("%s",s);
    for(int i=0;i<strlen(s);i++){
        if(s[i]=='*'){
            top--;
        }
        else{
            stack[++top]=s[i];
        }
    }
    stack[top+1]='\0';
    printf("%s",stack);
    return 0;
}
