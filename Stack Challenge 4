#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int stacknum=0;
int n1,n2,value;
int top1=-1;
int top2=-1;
void push1(int stack1[],int x){
    if(top1==n1-1){
        printf("Overflow\n");
    }
    else{
        top1++;
        stack1[top1]=x;
    }
}
void push2(int stack2[],int x){
    if(top2==n2-1){
        printf("Overflow\n");
    }
    else{
        top2++;
        stack2[top2]=x;
    }
}
void pop1(int stack1[]){
    if(top1==-1){
        printf("Underflow\n");
    }
    else{
        printf("%d\n",stack1[top1]);
        top1--;
    }
}
void pop2(int stack2[]){
    if(top2==-1){
        printf("Underflow\n");
    }
    else{
        printf("%d\n",stack2[top2]);
        top2--;
    }
}
void peek1(int stack1[]){
    if(top1==-1){
        printf("Underflow\n");
    }
    else{
        printf("%d\n",stack1[top1]);
    }
}
void peek2(int stack2[]){
    if(top2==-1){
        printf("Underflow\n");
    }
    else{
        printf("%d\n",stack2[top2]);
    }
}
void display1(int stack1[]){
    if(top1==-1){
        printf("Underflow\n");
    }
    else{
        for(int i=top1;i>=0;i--){
        printf("%d ",stack1[i]);
    }
    printf("\n");
    }
}
void display2(int stack2[]){
    if(top2==-1){
        printf("Underflow\n");
    }
    else{
        for(int i=top2;i>=0;i--){
        printf("%d ",stack2[i]);
    }
    printf("\n");
    }
}
int main(){
    scanf("%d %d",&n1,&n2);
    int stack1[n1],stack2[n2];
    int q;
    scanf("%d",&q);
    while(q--){
        char ch[20];
        scanf("%s",ch);
        if(ch[0]=='P'&&ch[1]=='U'){
            scanf("%d %d",&stacknum,&value);
            if(stacknum==1){
                push1(stack1,value);
            }
            else{
                push2(stack2,value);
            }
        }
        if(ch[0]=='P'&&ch[1]=='O'){
            scanf("%d",&stacknum);
            if(stacknum==1){
                pop1(stack1);
            }
            else{
                pop2(stack2);
            }
        }
        if(ch[0]=='P'&&ch[1]=='E'){
            scanf("%d",&stacknum);
            if(stacknum==1){
                peek1(stack1);
            }
            else{
                peek2(stack2);
            }
        }
        if(ch[0]=='D'){
            scanf("%d",&stacknum);
            if(stacknum==1){
                display1(stack1);
            }
            else{
                display2(stack2);
            }
        }
    }
    return 0;
}
